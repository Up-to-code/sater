	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#777777", "fontStyle": "italic" }
		},
		{
			"name": "Strings",
			"scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
			"settings": { "foreground": "#8DD6A8" }
		},
		{
			"name": "Keywords",
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new", "keyword.operator.delete"],
			"settings": { "foreground": "#FF6FAE" }
		},
		{
			"name": "Functions and methods",
			"scope": ["entity.name.function", "meta.function-call", "support.function", "variable.function"],
			"settings": { "foreground": "#2CCFA3" }
		},
		{
			"name": "Types and classes",
			"scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "support.class", "support.type"],
			"settings": { "foreground": "#78A9FF" }
		},
		{
			"name": "Variables and parameters",
			"scope": ["variable", "variable.parameter", "meta.definition.variable.name", "support.variable"],
			"settings": { "foreground": "#D6D8DF" }
		},
		{
			"name": "Constants",
			"scope": ["constant", "variable.other.constant", "variable.other.enummember"],
			"settings": { "foreground": "#74C7EC" }
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": { "foreground": "#F3A866" }
		},
		{
			"name": "Operators and punctuation",
			"scope": ["keyword.operator", "punctuation", "meta.brace", "meta.delimiter"],
			"settings": { "foreground": "#C2C2C2" }
		},
		{
			"name": "Tags",
			"scope": ["entity.name.tag", "punctuation.definition.tag"],
			"settings": { "foreground": "#FF7A9D" }
		},
		{
			"name": "Attributes and properties",
			"scope": ["entity.other.attribute-name", "support.type.property-name", "meta.object-literal.key"],
			"settings": { "foreground": "#78A9FF" }
		},
		{
			"name": "Regular expressions",
			"scope": ["string.regexp", "constant.regexp"],
			"settings": { "foreground": "#F3A866" }
		},
		{
			"name": "Invalid and deprecated",
			"scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
			"settings": { "foreground": "#FF6B72" }
		}
	],
	"semanticTokenColors": {
		"comment": { "foreground": "#777777", "italic": true },
		"string": "#8DD6A8",
		"keyword": "#FF6FAE",
		"function": "#2CCFA3",
		"method": "#2CCFA3",
		"type": "#78A9FF",
		"class": "#78A9FF",
		"interface": "#78A9FF",
		"namespace": "#78A9FF",
		"variable": "#D6D8DF",
		"parameter": "#D6D8DF",
		"property": "#78A9FF",
		"enumMember": "#74C7EC",
		"number": "#F3A866",
		"operator": "#C2C2C2",
		"regexp": "#F3A866"
	}
